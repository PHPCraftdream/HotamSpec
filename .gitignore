# internal/recorder/vendor/ is this project's own package (the scenario
# recorder's vendoring target for consumer domains), not a third-party Go
# vendor/ directory -- exempt it from the blanket rule above.
!internal/recorder/vendor/
# internal/ontology/vendor/ (task #365) is the same shape: this project's own
# package, not a third-party Go vendor/ directory -- exempt it too.
!internal/ontology/vendor/
